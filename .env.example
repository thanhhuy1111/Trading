# App & System Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
SYSTEM_MODE=PAPER_TRADING
LIVE_TRADING_ENABLED=false
FEATURE_FLAGS_LIVE_TRADING=false

# API Service
API_HOST=0.0.0.0
API_PORT=8000

# Infrastructure Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=trading_analytics

REDPANDA_BROKERS=localhost:9092

# Exchange Settings
BINANCE_API_KEY=testnet_api_key_placeholder
BINANCE_SECRET_KEY=testnet_secret_key_placeholder
BINANCE_TESTNET=true
EXCHANGE_NAME=binance_spot

# Trading Config
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAMES=15m,1h,4h
MAX_RISK_PER_TRADE_PCT=0.0025
MAX_OPEN_RISK_PCT=0.015
MAX_DAILY_LOSS_PCT=0.015
HARD_STOP_DRAWDOWN_PCT=0.08

# AI Trading Advisor -- Gemini provider (packages/chat_agent)
# Never commit a real key here. See docs/AI_TRADING_ADVISOR_GEMINI_SETUP.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_ENABLE_GOOGLE_SEARCH=false
GEMINI_REQUEST_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2

# AI Trading Advisor -- chat orchestrator bounds (packages/chat_agent/config.py)
CHAT_MAX_TOOL_ROUNDS=6
CHAT_MAX_TOTAL_TOOL_CALLS=10
CHAT_TOOL_TIMEOUT_SECONDS=20.0
CHAT_TOTAL_REQUEST_DEADLINE_SECONDS=60.0
CHAT_MAX_PROMPT_CHARS=4000
ENABLE_NEWS_RESEARCH=false

# AI Trading Advisor -- minimal API-key control + rate limits for /api/v1/chat and
# /api/v1/recommendations/* (apps/api/dependencies.py). Leave ADVISOR_API_KEY empty only
# for local development (ENVIRONMENT=development); set it before deploying anywhere else.
ADVISOR_API_KEY=
CHAT_RATE_LIMIT_PER_MINUTE=30
RECOMMENDATION_SCAN_RATE_LIMIT_PER_MINUTE=60

# AI Trading Advisor -- recommendation domain thresholds (packages/recommendation/config.py)
RECOMMENDATION_MIN_PROBABILITY_PROFIT=0.58
RECOMMENDATION_MIN_RISK_REWARD_RATIO=1.5
RECOMMENDATION_MAX_PROPOSALS=3
RECOMMENDATION_DEV_FIXTURE_MODE=false
